generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id          Int      @id @default(autoincrement())
  identidad   String   @unique
  nombre      String
  rol         String   
  contrasena  String?  
  solicitudes Solicitud[]
}

model Epp {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  stock       Int      @default(100)
  solicitudes SolicitudEpp[]
}

model Solicitud {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  motivo      String   
  firma       String   // Guardaremos la firma dibujada en base64
  estado      String   @default("Pendiente") 
  
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  
  epps        SolicitudEpp[]
}

model SolicitudEpp {
  id          Int      @id @default(autoincrement())
  solicitudId Int
  eppId       Int
  cantidad    Int
  
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  epp         Epp       @relation(fields: [eppId], references: [id])
}
